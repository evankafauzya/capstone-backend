# ---------------------------------------------------------------------------
# Moodle Proctoring AI Backend — example environment file
#
# Copy this file to `.env` and fill in the real values for your deployment.
# NEVER commit a real `.env` to version control.
#
# Quick start:
#   1. cp .env.example .env
#   2. Generate strong secrets:
#        python -c "import secrets; print(secrets.token_urlsafe(48))"
#      and paste them as SECRET_KEY / API_KEY below.
#   3. Set ENVIRONMENT=production for any non-local deployment.
# ---------------------------------------------------------------------------

# ---- Runtime ---------------------------------------------------------------
# One of: development | production
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# ---- Secrets (REQUIRED in production) --------------------------------------
# Session signing key. MUST be set in production.
SECRET_KEY=

# Bearer token clients must send as:  Authorization: Bearer <API_KEY>
# (Also accepted as X-API-Key: <API_KEY>.)
# Required in production. Leave blank in development to disable auth.
API_KEY=

# Set to false to allow unauthenticated requests (development only).
API_KEY_REQUIRED=true

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" only for local development.
CORS_ORIGINS=*

# ---- Rate limiting ---------------------------------------------------------
# Per-bucket cap (bucket = API token, or client IP when unauthenticated).
# slowapi syntax: "600/minute", "10/second", etc. Keep the default in
# production. Raise it (e.g. 1000000/minute) only when running a load test so
# requests reach the app instead of being rejected with 429 by the limiter.
RATE_LIMIT=600/minute

# ---- Proctoring tuning -----------------------------------------------------
CAPTURE_INTERVAL=5
REVERIFICATION_INTERVAL=30
SESSION_TIMEOUT=3600
EYE_MOVEMENT_THRESHOLD=0.3
EYE_ASPECT_RATIO_THRESHOLD=0.2
FACE_DETECTION_CONFIDENCE=0.5
# Cosine-similarity threshold for ArcFace verification.
# 0.4 is a good default for webcam-vs-registered-photo comparisons.
# Raise to 0.5+ only if both photos come from the same source.
FACE_MATCH_THRESHOLD=0.4
MAX_FACES_ALLOWED=1

# ---- Storage ---------------------------------------------------------------
# Enrollment + audit data live in a single SQLite file. Override the location
# if you mount a volume elsewhere (defaults to ./data/enrollments.db).
# DATA_DIR=./data
# ENROLLMENT_DB_PATH=./data/enrollments.db
